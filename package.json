{
  "name": "nanime",
  "version": "0.1.12",
  "description": "Nuxt module for animejs integration and transitions",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/astraldev/nanime.git"
  },
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/types.d.mts",
      "import": "./dist/module.mjs"
    }
  },
  "main": "./dist/module.mjs",
  "typesVersions": {
    "*": {
      ".": [
        "./dist/types.d.mts"
      ]
    }
  },
  "publishConfig": {
    "provenance": true
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "prepack": "nuxt-module-build build",
    "dev": "pnpm dev:prepare && pnpm -C docs dev",
    "dev:build": "pnpm -C docs build",
    "dev:prepare": "nuxt-module-build build --stub && nuxt-module-build prepare && pnpm -C docs prepare",
    "release": "pnpm lint && pnpm test && pnpm prepack && changelogen --release && pnpm publish --no-git-checks && git push --follow-tags",
    "build": "pnpm prepare && npm run prepack",
    "prepare": "nuxt-module-build prepare",
    "docs:build": "pnpm -C docs build",
    "docs:prepare": "pnpm -C docs prepare",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test:types": "nuxt typecheck",
    "clean": "rm -rf docs/.nuxt docs/.output .nuxt dist"
  },
  "dependencies": {
    "@nuxt/kit": "catalog:nuxt",
    "animejs": "catalog:runtime",
    "defu": "catalog:runtime"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@nuxt/eslint-config": "catalog:nuxt",
    "@nuxt/module-builder": "catalog:nuxt",
    "@nuxt/schema": "catalog:nuxt",
    "@nuxt/test-utils": "catalog:nuxt",
    "@types/node": "catalog:nuxt",
    "@vue/test-utils": "catalog:tooling",
    "@vueuse/core": "catalog:nuxt",
    "@vueuse/nuxt": "catalog:nuxt",
    "animejs": "catalog:runtime",
    "changelogen": "catalog:tooling",
    "eslint": "catalog:tooling",
    "h3-next": "npm:h3@^2.0.1-rc.22",
    "happy-dom": "catalog:tooling",
    "lefthook": "catalog:tooling",
    "nuxt": "catalog:nuxt",
    "typescript": "catalog:nuxt",
    "vitest": "catalog:tooling",
    "vue": "catalog:nuxt",
    "vue-tsc": "catalog:tooling"
  },
  "packageManager": "pnpm@10.15.0+sha512.486ebc259d3e999a4e8691ce03b5cac4a71cbeca39372a9b762cb500cfdf0873e2cb16abe3d951b1ee2cf012503f027b98b6584e4df22524e0c7450d9ec7aa7b"
}
